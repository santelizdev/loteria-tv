# Local dev con servicios expuestos en localhost.
# Este archivo es solo referencia. No commitear secretos reales.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret
DJANGO_TIME_ZONE=America/Caracas

DATABASE_URL=postgresql://loteria:loteria@127.0.0.1:5432/loteria
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
CSRF_TRUSTED_ORIGINS=

DEVICE_BYPASS_CODES=DEV,LOCAL

SCRAPER_ALERT_PRIMARY_CHANNEL=telegram
SCRAPER_TELEGRAM_BOT_TOKEN=123456:ABCDEF_REPLACE_ME
SCRAPER_TELEGRAM_CHAT_IDS=-1001234567890
SCRAPER_TELEGRAM_API_BASE_URL=https://api.telegram.org
SCRAPER_ADMIN_BASE_URL=http://127.0.0.1:8000
SCRAPER_ALERT_NOTIFY_COOLDOWN_MINUTES=180
# 0 por defecto para no llenar grupos por error en desarrollo.
ADMIN_ACTIVITY_TELEGRAM_ENABLED=0
SCRAPER_INCIDENT_VIEWER_GROUPS=Administradores
SCRAPER_INCIDENT_RESOLVER_GROUPS=Administradores
