# Referencia para staging/produccion en servidor o VM.
# No asume Docker en runtime. Ajustar DATABASE_URL y REDIS_URL al host real.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=
DJANGO_TIME_ZONE=America/Santiago

DATABASE_URL=postgresql://loteria:loteria@127.0.0.1:5432/loteria
REDIS_URL=redis://127.0.0.1:6379/1
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/0

SCRAPER_ALERT_PRIMARY_CHANNEL=telegram
SCRAPER_TELEGRAM_BOT_TOKEN=
SCRAPER_TELEGRAM_CHAT_IDS=
SCRAPER_TELEGRAM_API_BASE_URL=https://api.telegram.org
SCRAPER_ADMIN_BASE_URL=
SCRAPER_ALERT_NOTIFY_COOLDOWN_MINUTES=180
# Mantener apagado hasta que operacion confirme el grupo destino.
ADMIN_ACTIVITY_TELEGRAM_ENABLED=0
SCRAPER_INCIDENT_VIEWER_GROUPS=Administradores
SCRAPER_INCIDENT_RESOLVER_GROUPS=Administradores
